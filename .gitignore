# Go build artifacts
/out
backend/notation
backend/notation.exe

# Frontend
frontend/node_modules
frontend/dist

# Embedded build output (regenerated by `npm run build`). Only .gitkeep is
# checked in so `//go:embed all:dist` always has at least one file to match.
backend/web/dist/*
!backend/web/dist/.gitkeep

# Runtime data
/data

# Environment
.env
.env.*
!.env.example

# Editors
.vscode/
.idea/
.DS_Store

# Logs
*.log
