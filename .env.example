# notation config. Copy to .env and adjust:  cp .env.example .env
# (.env is gitignored.)

# ============================================================================
# Docker Compose deployment (docker-compose.yml)
# These feed the compose file's ${...} placeholders. All have matching defaults
# in docker-compose.yml, so .env is optional for deployment.
# ============================================================================

# Public hostname → Caddy site label + WebAuthn RP ID.
NOTATION_DOMAIN=notes.example.com
NOTATION_RP_ID=notes.example.com

# Running behind a reverse proxy (Caddy)? Honour X-Forwarded-* headers.
NOTATION_TRUST_PROXY=1

# Host path for persistent data (spaces, git, TTS cache, …).
NOTATION_DATA=/opt/notation_data

# Your existing external Caddy / reverse-proxy docker network.
PROXY_NETWORK=proxy_network

# --- Optional higher-quality German read-aloud voice (Kokoro sidecar) ---
# Auto-wired to the sidecar over the shared 'tts' network. Set empty
# (NOTATION_TTS_KOKORO_URL=) to disable Kokoro and use Piper only.
NOTATION_TTS_KOKORO_URL=http://kokoro:8080
NOTATION_TTS_KOKORO_VOICES=de_DE-martin-kokoro
# Model auto-downloads into ./kokoro-models on first start (gitignored, reused
# if already present). Change repo/voice to use a different model.
KOKORO_HF_REPO=Godelaune/Kokoro-82M-ONNX-German-Martin
KOKORO_VOICE=martin
KOKORO_LANG=de

# ============================================================================
# Local dev: running the Go binary directly (NOT used by docker-compose.yml,
# which only forwards the variables listed in its `environment:` blocks)
# ============================================================================
# NOTATION_DEV_BYPASS_AUTH=1      # bypass auth — do NOT set in production
# NOTATION_BIND=:8080
# NOTATION_DATA_DIR=./data
# NOTATION_SHARE_PATH=/s
# NOTATION_MCP_PATH=/mcp
# NOTATION_BASE_URL=http://localhost:8080
